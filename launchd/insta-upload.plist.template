<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vorlage; launchd/install.sh setzt die Platzhalter ein. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DIR__/venv/bin/python</string>
        <string>__DIR__/insta_upload.py</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <!-- alle 5 Minuten; verpasste Läufe (Ruhezustand) holt launchd nach dem Aufwachen nach -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__DIR__/logs/insta-upload.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/logs/insta-upload.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
