# Instagram-Konto (Business oder Creator) und Langzeit-Zugriffstoken (Instagram-Login).
# Der Token wird automatisch verlängert und danach in state.db gespeichert.
# Trägst du hier einen neuen Token ein, wird der gespeicherte ersetzt.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=IGAA...

# Öffentliche Basis-URL deines Medien-Ordners bei Infomaniak (mit / am Ende)
MEDIA_BASE_URL=https://example.infomaniak.ch/insta/

# Optional
# SCHEDULE_FILE=posts.csv
# STATE_DB=state.db
# TIMEZONE=Europe/Berlin
# MAX_ATTEMPTS=3
# Token alle n Tage verlängern (gültig ist er jeweils 60 Tage)
# TOKEN_REFRESH_DAYS=7
# Instagram-Login: https://graph.instagram.com (Standard), Facebook-Login: https://graph.facebook.com
# GRAPH_HOST=https://graph.instagram.com
# GRAPH_API_VERSION=v24.0
